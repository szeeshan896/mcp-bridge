{
  "name": "mcpbridge",
  "version": "0.1.0",
  "description": "Delegate work to another AI agent from inside the one you are already in, over MCP, with no API keys",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "claude",
    "gemini",
    "codex",
    "ollama",
    "delegation"
  ],
  "license": "MIT",
  "author": "Syed Zeeshan Ali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szeeshan896/mcpbridge.git"
  },
  "homepage": "https://github.com/szeeshan896/mcpbridge#readme",
  "type": "module",
  "bin": {
    "mcpbridge": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "tsc --noEmit && node --test --import tsx \"test/**/*.test.ts\"",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "@types/ws": "8.18.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "default": "./dist/connect.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./registry": {
      "types": "./dist/agents/registry.d.ts",
      "default": "./dist/agents/registry.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./limit": {
      "types": "./dist/limit.d.ts",
      "default": "./dist/limit.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  }
}
